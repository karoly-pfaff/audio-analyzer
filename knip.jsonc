{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "sources/index.ts",
        "sources/signal.ts",
        "sources/spectrum.ts",
        "sources/tempo.ts",
        "docs/site/sources/main.ts",
        "scripts/**/*.test.mjs",
      ],
      "project": [
        "sources/**/*.ts",
        "scripts/**/*.mjs",
        "tests/fixtures/**/*.ts",
        "docs/site/sources/**/*.ts",
        "*.config.{ts,mjs}",
      ],
    },
    "tests/integration/consumer": {
      "entry": ["consumer.ts"],
      "project": ["*.{ts,mjs}"],
    },
  },
}
